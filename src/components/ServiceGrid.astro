---
const feather = 'fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"';

const services = [
  {
    title: 'Contabilitate',
    href: '/services/servicii-contabilitate/',
    icon: `<svg viewBox="0 0 24 24" ${feather} xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"/><line x1="3" y1="9" x2="21" y2="9"/><line x1="9" y1="21" x2="9" y2="9"/></svg>`,
  },
  {
    title: 'Expertiza Contabila',
    href: '/services/expertiza-contabila/',
    icon: `<svg viewBox="0 0 24 24" ${feather} xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>`,
  },
  {
    title: 'Consultanta Fiscala',
    href: '/services/consultanta-fiscala/',
    icon: `<svg viewBox="0 0 24 24" ${feather} xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><polyline points="23 6 13.5 15.5 8.5 10.5 1 18"/><polyline points="17 6 23 6 23 12"/></svg>`,
  },
  {
    title: 'Salarizare',
    href: '/services/salarizare-si-resurse-umane/',
    icon: `<svg viewBox="0 0 640 512" fill="currentColor" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path d="M352 288h-16v-88c0-4.42-3.58-8-8-8h-13.58c-4.74 0-9.37 1.4-13.31 4.03l-15.33 10.22a7.994 7.994 0 0 0-2.22 11.09l8.88 13.31a7.994 7.994 0 0 0 11.09 2.22l.47-.31V288h-16c-4.42 0-8 3.58-8 8v16c0 4.42 3.58 8 8 8h64c4.42 0 8-3.58 8-8v-16c0-4.42-3.58-8-8-8zM608 64H32C14.33 64 0 78.33 0 96v320c0 17.67 14.33 32 32 32h576c17.67 0 32-14.33 32-32V96c0-17.67-14.33-32-32-32zM48 400v-64c35.35 0 64 28.65 64 64H48zm0-224v-64h64c0 35.35-28.65 64-64 64zm272 192c-53.02 0-96-50.15-96-112 0-61.86 42.98-112 96-112s96 50.14 96 112c0 61.87-43 112-96 112zm272 32h-64c0-35.35 28.65-64 64-64v64zm0-224c-35.35 0-64-28.65-64-64h64v64z"/></svg>`,
  },
  {
    title: 'Servicii de Fiscalitate',
    href: '/services/consultanta-fiscala/',
    icon: `<svg viewBox="0 0 24 24" ${feather} xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/></svg>`,
  },
  {
    title: 'Alte Servicii',
    href: null,
    icon: `<svg viewBox="0 0 24 24" ${feather} xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="12" y1="18" x2="12" y2="12"/><line x1="9" y1="15" x2="15" y2="15"/></svg>`,
  },
];
---

<div class="grid grid-cols-1 md:grid-cols-3 gap-x-8 gap-y-8">
  {services.map((s) => {
    const inner = (
      <>
        <div class="w-[50px] h-[50px] text-[#3296ff] mb-[15px]"><Fragment set:html={s.icon} /></div>
        <h2 class="text-[22px] font-normal text-[#3296ff] mt-[5px] mb-[10px]">{s.title}</h2>
      </>
    );
    const cls =
      'block bg-[#1a202c] rounded-[10px] p-[30px] shadow-[0_20px_30px_rgba(0,0,0,0.1)] hover:shadow-[0_20px_45px_rgba(0,0,0,0.1)] transition-shadow';
    return s.href ? (
      <a href={s.href} class={cls}>{inner}</a>
    ) : (
      <div class={cls}>{inner}</div>
    );
  })}
</div>

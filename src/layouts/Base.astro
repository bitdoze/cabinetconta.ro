---
import '../styles/global.css';

interface Props {
  title: string;
  canonical: string;
}

const { title, canonical } = Astro.props;

const BLOG_URL =
  '/bine-ati-venit-pe-blogul-cabinet-conta-unde-impartasim-cele-mai-recente-noutati-si-sfaturi-utile-in-domeniul-contabilitatii-fie-ca-sunteti-antreprenor-contabil-sau-doriti-sa-intelegeti-mai-bine-asp/';

const nav = [
  { label: 'Home', href: '/' },
  {
    label: 'Servicii',
    href: '/services/',
    children: [
      { label: 'Servicii Contabilitate', href: '/services/servicii-contabilitate/' },
      { label: 'Consultanta Fiscala', href: '/services/consultanta-fiscala/' },
      { label: 'Expertiza Contabila', href: '/services/expertiza-contabila/' },
      { label: 'Salarizare Si Resurse Umane', href: '/services/salarizare-si-resurse-umane/' },
    ],
  },
  { label: 'Preturi', href: '/preturi/' },
  { label: 'Contact', href: '/contact/' },
  { label: 'Despre Noi', href: '/about/' },
  { label: 'Blog', href: BLOG_URL },
];
---

<!doctype html>
<html lang="ro-RO">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, minimum-scale=1" />
    <meta name="robots" content="max-image-preview:large" />
    <meta name="generator" content="WordPress 7.1.4" />
    <meta name="msapplication-TileImage" content="/wp-content/uploads/2020/04/cropped-Digital_logo-1-300x300.png" />
    <title>{title}</title>
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/wp-content/uploads/2020/04/cropped-Digital_logo-1-150x150.png" sizes="32x32" />
    <link rel="icon" href="/wp-content/uploads/2020/04/cropped-Digital_logo-1-300x300.png" sizes="192x192" />
    <link rel="apple-touch-icon" href="/wp-content/uploads/2020/04/cropped-Digital_logo-1-300x300.png" />
  </head>
  <body class="min-h-screen flex flex-col">
    <header id="masthead" class="fixed top-0 left-0 right-0 z-50 transition-colors duration-300">
      <div class="max-w-[1290px] mx-auto px-6 flex items-center justify-between h-20">
        <a href="/" class="flex items-center gap-3 shrink-0">
          <img src="/wp-content/uploads/2020/04/digital_white_min.png" width="50" height="50" alt="Cabinet Conta" />
          <span class="font-heading font-extrabold text-[26px] leading-tight uppercase text-white">Cabinet Conta</span>
        </a>
        <nav class="hidden lg:block" aria-label="Meniu principal">
          <ul class="flex items-center">
            {nav.map((item) => (
              <li class="relative group">
                <a
                  href={item.href}
                  class="block px-[0.6em] py-[0.6em] font-heading text-[#f7fafc] hover:text-[#3296ff] transition-colors"
                >
                  {item.label}
                  {item.children && (
                    <svg class="inline-block w-3 h-3 ml-1 -mt-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="6 9 12 15 18 9"/></svg>
                  )}
                </a>
                {item.children && (
                  <ul class="absolute left-0 top-full hidden group-hover:block bg-white shadow-[0_2px_13px_rgba(0,0,0,0.1)] rounded-b min-w-[220px] py-0">
                    {item.children.map((sub) => (
                      <li class="border-b border-black/10 last:border-b-0">
                        <a href={sub.href} class="block w-[220px] px-4 py-4 text-xs text-[#252c39] hover:text-[#1a202c] hover:bg-[#f7fafc]">
                          {sub.label}
                        </a>
                      </li>
                    ))}
                  </ul>
                )}
              </li>
            ))}
          </ul>
        </nav>
        <button id="menu-toggle" class="lg:hidden text-white p-2" aria-label="Toggle Menu" aria-expanded="false">
          <svg class="w-7 h-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
        </button>
      </div>
      <div id="mobile-menu" class="hidden lg:hidden bg-[#1a202c] border-t border-white/10">
        <ul class="px-6 py-4">
          {nav.map((item) => (
            <li>
              <a href={item.href} class="block py-3 text-[#f7fafc] hover:text-[#3296ff]">{item.label}</a>
              {item.children && (
                <ul class="pl-4 pb-2">
                  {item.children.map((sub) => (
                    <li><a href={sub.href} class="block py-2 text-sm text-[#cbd2d9] hover:text-[#3296ff]">{sub.label}</a></li>
                  ))}
                </ul>
              )}
            </li>
          ))}
        </ul>
      </div>
    </header>

    <main id="main" class="flex-1">
      <slot />
    </main>

    <footer class="bg-[#1a202c]">
      <div class="max-w-[1290px] mx-auto px-6 py-12 flex flex-wrap items-center justify-center gap-x-8 gap-y-6">
        <a href="https://reclamatiisal.anpc.ro/">
          <img src="/wp-content/uploads/2026/03/sal1.webp" alt="Solutii alternative de litigii" width="409" height="100" class="w-[207px] h-auto" />
        </a>
        <a href="https://europa.eu/youreurope/business/dealing-with-customers/solving-disputes/alternative-dispute-resolution/index_ro.htm">
          <img src="/wp-content/uploads/2026/03/sol2.webp" alt="Solutii online de litigii" width="409" height="100" class="w-[205px] h-auto" />
        </a>
      </div>
      <div class="max-w-[1290px] mx-auto px-6 pb-10 text-center text-sm text-[#718096]">
        <p>&copy; 2026 Cabinet Conta &middot; <a href="/politica-confidentialitate/" class="hover:text-[#3296ff]">Politica de Confidentialitate</a></p>
      </div>
    </footer>

    <div id="cookie-banner" class="hidden fixed bottom-0 left-0 right-0 z-40 bg-[#252c39] border-t border-white/10">
      <div class="max-w-[1290px] mx-auto px-6 py-4 flex flex-col sm:flex-row items-center justify-center gap-4 text-center sm:text-left">
        <p class="text-sm text-[#cbd2d9]">
          Acest site nu foloseste cookie-uri de urmarire. Prin continuarea navigarii sunteti de acord cu{' '}
          <a href="/politica-confidentialitate/" class="text-[#3296ff] hover:underline">Politica de Confidentialitate</a>.
        </p>
        <button id="cookie-accept" class="shrink-0 bg-[#3296ff] text-white text-sm rounded-full px-5 py-1.5 hover:bg-[#003174] transition-colors">Am inteles</button>
      </div>
    </div>

    <script>
      const header = document.getElementById('masthead');
      const toggle = document.getElementById('menu-toggle');
      const menu = document.getElementById('mobile-menu');
      const update = () => {
        const menuOpen = menu && !menu.classList.contains('hidden');
        if (header) {
          header.classList.toggle('bg-[#1a202c]', window.scrollY > 40 || !!menuOpen);
          header.classList.toggle('shadow-lg', window.scrollY > 40 || !!menuOpen);
        }
      };
      toggle?.addEventListener('click', () => {
        menu?.classList.toggle('hidden');
        toggle.setAttribute('aria-expanded', menu && !menu.classList.contains('hidden') ? 'true' : 'false');
        update();
      });
      window.addEventListener('scroll', update, { passive: true });
      update();

      const banner = document.getElementById('cookie-banner');
      if (banner && !localStorage.getItem('gdpr-notice')) {
        banner.classList.remove('hidden');
      }
      document.getElementById('cookie-accept')?.addEventListener('click', () => {
        localStorage.setItem('gdpr-notice', '1');
        banner?.classList.add('hidden');
      });
    </script>
  </body>
</html>

---
import Base from '../../layouts/Base.astro';
import Hero from '../../components/Hero.astro';
---

<Base title="Expertiza Contabila – Cabinet Conta" canonical="https://cabinetconta.ro/services/expertiza-contabila/">
  <Hero heading="Expertiza Contabila" headingTag="h2" bold bgImage="/img/hero-bg.jpg" overlayOpacity={0.9} />
  <section class="bg-[#1a202c]">
    <div class="max-w-[1200px] mx-auto px-6 py-16 text-[#edf2f7]">
      <p class="mb-4">Expertiza contabila judiciara</p>
      <p class="mb-4">Expertiza contabila amiabila</p>
      <p class="mb-4">Evaluarea patrimoniului societatii</p>
      <p class="mb-4">Verificarea si certificarea bilantului contabil</p>
      <p class="mb-4">Activitate de cenzorat</p>
    </div>
  </section>
</Base>

---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
---

<Base title="Contact – Cabinet Conta" canonical="https://cabinetconta.ro/contact/">
  <Hero heading="Contact" headingTag="h1" />
  <section class="bg-[#1a202c]">
    <div class="max-w-[1200px] mx-auto px-6 py-16 grid grid-cols-1 lg:grid-cols-2 gap-14">
      <div>
        <h3 class="font-condensed uppercase tracking-[4px] text-[16px] md:text-[20px] font-normal text-[#3296ff] mb-3 text-left">Luati legatura cu noi</h3>
        <h2 class="text-[30px] md:text-[38px] leading-[1.3em] font-normal text-white mb-[30px] text-left">Sunati-ne sau trimiteti-ne un email.</h2>
        <div class="space-y-6">
          <a href="tel:0724706436" class="flex items-center gap-4 group">
            <span class="flex items-center justify-center w-14 h-14 rounded-full border-2 border-[#3296ff] text-[#3296ff] shrink-0">
              <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
            </span>
            <span>
              <span class="block text-sm uppercase tracking-widest text-[#cbd2d9]">Telefon</span>
              <span class="block text-[22px] font-medium text-white group-hover:text-[#3296ff] transition-colors">0724706436</span>
            </span>
          </a>
          <a href="mailto:cabinetconta@yahoo.com" class="flex items-center gap-4 group">
            <span class="flex items-center justify-center w-14 h-14 rounded-full border-2 border-[#3296ff] text-[#3296ff] shrink-0">
              <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="4" width="20" height="16" rx="2"/><polyline points="22 6 12 13 2 6"/></svg>
            </span>
            <span>

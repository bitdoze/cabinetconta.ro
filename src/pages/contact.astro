              <span class="block text-[22px] font-medium text-white group-hover:text-[#3296ff] transition-colors">cabinetconta@yahoo.com</span>
            </span>
          </a>
        </div>
      </div>
      <div>
        <h3 class="font-condensed uppercase tracking-[4px] text-[16px] md:text-[20px] font-normal text-[#3296ff] mb-3 text-left">Contactati-ne</h3>
        <h2 class="text-[30px] md:text-[38px] leading-[1.3em] font-normal text-white mb-[30px] text-left">Suntem bucurosi sa vorbim cu dumneavoastra.</h2>
        <p class="mb-4 text-[#edf2f7]">

---
import Base from '../../layouts/Base.astro';

const posts = [
  {
    title: 'Cum obti dividendele la o firma si ce impozit platesti.',
    href: '/cum-obti-dividendele-la-o-firma/',
    date: 'septembrie 19, 2024',
    excerpt:
      'Dacă obții venituri din dividende ale persoanelor fizice din partea unei persoane juridice în România, trebuie să plătești următoarea taxă și contribuție: 1. Impozit pe dividende : Impozitul pe dividende este de 10% din valoare dividendelor brute distribuite. Persoana juridică este obligată să rețină și să vireze acest impozit către stat înainte de a distribui…',
    image: '/wp-content/uploads/2024/09/2856634_stock-photo-3d-accounting-concept.jpg',
  },
];
---

<Base title="Clients – Cabinet Conta" canonical="https://cabinetconta.ro/category/clients/">
  <section class="bg-[#1a202c]">
    <div class="max-w-[1200px] mx-auto px-6 pt-[160px] pb-8">
      <h1 class="text-4xl md:text-[45px] font-bold text-white">Clients</h1>
    </div>
    <div class="max-w-[1200px] mx-auto px-6 pb-20 space-y-10">
      {posts.map((post) => (
        <article class="bg-[#252c39] rounded-lg overflow-hidden shadow-[0_15px_15px_-10px_rgba(0,0,0,0.05)]">
          {post.image && (
            <a href={post.href} class="block">
              <img src={post.image} alt={post.title} width="600" height="600" class="w-full h-auto max-h-[400px] object-cover" loading="lazy" />
            </a>
          )}
          <div class="p-8">
            <h2 class="text-2xl font-bold text-white mb-3">
              <a href={post.href} class="hover:text-[#3296ff] transition-colors">{post.title}</a>
            </h2>
            <div class="text-sm text-[#cbd2d9] mb-4">By <span class="text-[#3296ff]">admin</span> {post.date}</div>
            <p class="text-[#edf2f7] leading-relaxed mb-4">{post.excerpt}</p>
            <p>
              <a href={post.href} class="text-[#3296ff] font-semibold hover:underline">Citeste mai mult<svg class="inline-block w-[20px] h-[20px] -mt-0.5" viewBox="0 0 27 28" fill="currentColor" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path d="M27 13.953c0 0.141-0.063 0.281-0.156 0.375l-6 5.531c-0.156 0.141-0.359 0.172-0.547 0.094-0.172-0.078-0.297-0.25-0.297-0.453v-3.5h-19.5c-0.281 0-0.5-0.219-0.5-0.5v-3c0-0.281 0.219-0.5 0.5-0.5h19.5v-3.5c0-0.203 0.109-0.375 0.297-0.453 0.188-0.078 0.391-0.047 0.547 0.094l6 5.531c0.094 0.094 0.156 0.234 0.156 0.375z"/></svg></a>
            </p>
          </div>
        </article>
      ))}
    </div>
  </section>
</Base>
